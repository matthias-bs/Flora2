///////////////////////////////////////////////////////////////////////////////
// secrets.h.example — Template for WiFi and MQTT credentials
//
// Rename this file to secrets.h and fill in your real credentials.
// This file IS tracked in version control (no real credentials here).
///////////////////////////////////////////////////////////////////////////////

#pragma once

// WiFi networks — tried in order until one connects.
static const struct { const char* ssid; const char* password; } WIFI_NETWORKS[] = {
    { "YourSSID1",   "YourPassword1" },
    { "YourSSID2",   "YourPassword2" },
};
static const uint8_t NUM_WIFI_NETWORKS =
    sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);

// MQTT broker credentials
// Use port 1883 for plain MQTT. For TLS, set MQTT_PORT to 8883, define
// MQTT_TLS_EN in Flora2Cfg.h, and upload the broker CA cert as
// data/root_ca.pem in LittleFS. Optional (not recommended): define
// MQTT_TLS_ALLOW_INSECURE_FALLBACK to permit insecure TLS when CA loading fails.
#define MQTT_HOST       "your.mqtt.broker.example.com"
#define MQTT_PORT       1883
#define MQTT_USERNAME   "your_mqtt_user"
#define MQTT_PASSWORD   "your_mqtt_password"
